# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratchpad directories
/scratch

# scratch / forensic throwaway files (root-level only, not docs/)
/scratch_*

# golden reproduction fixtures — real bid files (confidential pricing).
# The folder + its .gitkeep/README are tracked; every workbook in it is NOT.
/fixtures/golden/*
!/fixtures/golden/.gitkeep
!/fixtures/golden/README.md

# python recovery scripts
/*.py

# real past-bid workbooks for import testing (confidential pricing).
/fixtures/past-bids/*
!/fixtures/past-bids/.gitkeep
