{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "npx tsc --noEmit" }] },
      { "hooks": [{ "type": "command", "command": "node -e \"const { execSync } = require('child_process'); try { const t = parseInt(execSync('git log -1 --format=%ct').toString().trim()); if (Date.now()/1000 - t < 120) console.log('--- Commit detected. Run /compact to trim context before continuing. ---'); } catch(e){}\"" }] }
    ]
  },
  "permissions": {
